---
import Photo from './Photo.astro';
import { property } from '../config/property';
const { story } = property;
const [first, ...rest] = story.paragraphs;
---

<section class="bg-ivory pb-24 md:pb-40" aria-labelledby="story-heading">
  <div class="container-x">
    <div class="grid gap-x-10 md:grid-cols-12">
      <div class="md:col-span-10 lg:col-span-9" data-reveal>
        <p class="eyebrow flex items-center gap-4"><span class="brass-rule"></span>{story.eyebrow}</p>
        <h2 id="story-heading" class="display mt-7 text-[clamp(2.5rem,6.4vw,5.4rem)]">{story.heading}</h2>
      </div>
    </div>

    <div class="mt-14 grid items-start gap-12 md:mt-24 md:grid-cols-12 md:gap-x-10">
      <div class="md:col-span-6 lg:col-span-7">
        <Photo id={story.photo} sizes="(min-width: 1024px) 55vw, (min-width: 768px) 50vw, 100vw" />
      </div>
      <div class="prose-editorial md:col-span-6 md:pt-6 lg:col-span-4 lg:col-start-9 lg:pt-24" data-reveal>
        <p class="lede !text-charcoal">{first}</p>
        <div class="mt-8 space-y-5">
          {rest.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
