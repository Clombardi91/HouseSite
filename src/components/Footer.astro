---
import Mark from './Mark.astro';
import { property } from '../config/property';
import { identity, cityLine } from '../lib/content';
const year = new Date().getFullYear();
---

<footer class="bg-charcoal pb-28 text-white/60 md:pb-12">
  <div class="container-x border-t border-white/10 pt-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="flex items-center gap-4 text-ivory">
        <Mark class="h-10 w-10" />
        <div>
          <p class="font-serif text-xl leading-tight">{identity()}</p>
          {property.address.street && <p class="text-sm text-white/60">{cityLine()}</p>}
        </div>
      </div>
      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-10 gap-y-3 text-[0.66rem] font-medium uppercase tracking-[0.22em] sm:grid-cols-3">
          <li><a class="hover:text-white" href="#gallery">Gallery</a></li>
          <li><a class="hover:text-white" href="#details">Details</a></li>
          <li><a class="hover:text-white" href="#documents">Documents</a></li>
          <li><a class="hover:text-white" href="#location">Location</a></li>
          <li><a class="hover:text-white" href="#contact">Contact</a></li>
          <li><a class="hover:text-white" href="#top">Back to top ↑</a></li>
        </ul>
      </nav>
    </div>
    <p class="mt-14 max-w-3xl text-[0.75rem] leading-relaxed text-white/45">{property.legal}</p>
    <p class="mt-3 text-[0.7rem] text-white/35">© {year}</p>
  </div>
</footer>
