---
import Placeholder from './Placeholder.astro';
import { property } from '../config/property';
import { mapsQuery, fullAddress } from '../lib/content';

const { location } = property;
const q = encodeURIComponent(mapsQuery());
const embed = `https://maps.google.com/maps?q=${q}&z=${fullAddress() ? 15 : 12}&output=embed`;
const link = `https://www.google.com/maps/search/?api=1&query=${q}`;
---

<section id="location" class="border-t border-line bg-paper py-24 md:py-36" aria-labelledby="location-heading">
  <div class="container-x grid gap-14 md:grid-cols-12 md:gap-x-10">
    <div class="md:col-span-5 lg:col-span-4" data-reveal>
      <p class="eyebrow flex items-center gap-4"><span class="brass-rule"></span>Location</p>
      <h2 id="location-heading" class="heading mt-7">{location.heading}</h2>
      <div class="prose-editorial mt-7">
        {location.intro.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-10 border-t border-line pt-7">
        <h3 class="text-[0.66rem] font-medium uppercase tracking-[0.22em] text-muted">The Neighborhood</h3>
        <p class="mt-3 text-ink">{location.neighborhood ?? <Placeholder label="Neighborhood description" />}</p>
      </div>

      <div class="mt-8 border-t border-line pt-7">
        <h3 class="text-[0.66rem] font-medium uppercase tracking-[0.22em] text-muted">Nearby</h3>
        {location.nearby.length ? (
          <ul class="mt-3 space-y-2">
            {location.nearby.map((n) => <li class="flex justify-between gap-6 border-b border-line pb-2"><span>{n.name}</span>{n.detail && <span class="text-right text-muted">{n.detail}</span>}</li>)}
          </ul>
        ) : (
          <p class="mt-3"><Placeholder label="Verified nearby amenities" /></p>
        )}
      </div>

      <a href={link} target="_blank" rel="noopener" class="btn btn-ghost mt-10">
        Open in Google Maps
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
      </a>
    </div>

    {location.showMap && (
      <div class="md:col-span-7 md:col-start-6 lg:col-span-7 lg:col-start-6" data-reveal>
        <div class="map relative aspect-[4/5] w-full overflow-hidden bg-[#e4ddd1] sm:aspect-[4/3] md:aspect-auto md:h-full md:min-h-[34rem]">
          <iframe
            title={`Map of ${mapsQuery()}`}
            src={embed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 h-full w-full border-0"
          ></iframe>
        </div>
        {!fullAddress() && <p class="mt-3 text-[0.75rem] text-muted">Map shows the City of Mebane. The exact location will appear once the address is published.</p>}
      </div>
    )}
  </div>
</section>

<style>
  .map iframe { filter: grayscale(0.85) sepia(0.12) contrast(0.95); transition: filter 0.6s; }
  .map:hover iframe, .map:focus-within iframe { filter: none; }
</style>
