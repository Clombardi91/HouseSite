---
import Photo from './Photo.astro';
import type { Property } from '../config/property';
import { getPhoto } from '../lib/content';

interface Props { space: Property['featured'][number]; index: number }
const { space, index } = Astro.props;
const [main, ...more] = space.photos;
const num = String(index + 1).padStart(2, '0');
const aspect = (id: string) => getPhoto(id)?.aspect ?? 1.5;
const dark = space.layout === 'portrait';
const headingId = `space-${space.id}`;
---

<article
  class:list={['space relative', dark ? 'bg-charcoal py-24 text-ivory md:py-36' : 'py-20 md:py-32', space.layout === 'split-reverse' || space.layout === 'panorama' ? 'bg-paper' : !dark && 'bg-ivory']}
  aria-labelledby={headingId}
>

  {space.layout === 'split' && (
    <div class="container-x grid items-center gap-12 md:grid-cols-12 md:gap-x-10">
      <div class="md:col-span-7"><Photo id={main} sizes="(min-width: 768px) 58vw, 100vw" /></div>
      <div class="md:col-span-5 lg:col-span-4 lg:col-start-9">
        <div data-reveal>
          <p class="eyebrow">{num} — {space.eyebrow}</p>
          <h3 id={headingId} class="heading mt-6">{space.title}</h3>
          <div class="prose-editorial mt-7">{space.body.map((p) => <p>{p}</p>)}</div>
        </div>
        {more[0] && <Photo id={more[0]} class="ml-auto mt-12 w-3/4 md:w-2/3" sizes="(min-width: 768px) 25vw, 75vw" />}
      </div>
    </div>
  )}

  {space.layout === 'split-reverse' && (
    <div class="container-x grid items-center gap-12 md:grid-cols-12 md:gap-x-10">
      <div class="md:order-2 md:col-span-7 md:col-start-6">
        <div class="aspect-row stack-sm" style="--row-gap: 0.75rem">
          {space.photos.map((id) => <div style={`--aspect:${aspect(id)}`}><Photo id={id} sizes="(min-width: 768px) 30vw, 100vw" /></div>)}
        </div>
      </div>
      <div class="md:order-1 md:col-span-5 lg:col-span-4" data-reveal>
        <p class="eyebrow">{num} — {space.eyebrow}</p>
        <h3 id={headingId} class="heading mt-6">{space.title}</h3>
        <div class="prose-editorial mt-7">{space.body.map((p) => <p>{p}</p>)}</div>
      </div>
    </div>
  )}

  {space.layout === 'mosaic' && (
    <div class="container-x">
      <div class="grid gap-8 md:grid-cols-12 md:gap-x-10" data-reveal>
        <div class="md:col-span-6">
          <p class="eyebrow">{num} — {space.eyebrow}</p>
          <h3 id={headingId} class="heading mt-6">{space.title}</h3>
        </div>
        <div class="prose-editorial md:col-span-5 md:col-start-8 md:pt-12">{space.body.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="mt-14 space-y-3 md:mt-20">
        <Photo id={main} sizes="(min-width: 1472px) 1344px, 100vw" maxVh={82} />
        {more.length > 0 && (
          <div class="aspect-row" style="--row-gap: 0.75rem">
            {more.map((id) => <div style={`--aspect:${aspect(id)}`}><Photo id={id} sizes="50vw" /></div>)}
          </div>
        )}
      </div>
    </div>
  )}

  {space.layout === 'wide' && (
    <div>
      <div class="container-x mb-12 md:mb-20" data-reveal>
        <p class="eyebrow">{num} — {space.eyebrow}</p>
        <h3 id={headingId} class="heading mt-6 max-w-3xl">{space.title}</h3>
      </div>
      <div class="md:px-10 xl:px-16"><Photo id={main} sizes="100vw" maxVh={86} /></div>
      <div class="container-x mt-14 grid items-start gap-12 md:mt-20 md:grid-cols-12 md:gap-x-10">
        <div class="prose-editorial md:col-span-5 lg:col-span-4" data-reveal>{space.body.map((p) => <p>{p}</p>)}</div>
        {more.length > 0 && (
          <div class="md:col-span-7 md:col-start-6 lg:col-span-7 lg:col-start-6">
            <div class="aspect-row" style="--row-gap: 0.75rem">
              {more.map((id) => <div style={`--aspect:${aspect(id)}`}><Photo id={id} sizes="(min-width: 768px) 30vw, 50vw" caption /></div>)}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  {space.layout === 'portrait' && (
    <div class="container-x grid items-start gap-14 md:grid-cols-12 md:gap-x-10">
      <div class="md:sticky md:top-28 md:col-span-5 lg:col-span-4" data-reveal>
        <p class="eyebrow !text-sage-soft">{num} — {space.eyebrow}</p>
        <h3 id={headingId} class="heading mt-6">{space.title}</h3>
        {space.stat && (
          <div class="mt-10 flex items-end gap-5 border-y border-white/15 py-7">
            <span class="font-serif text-[clamp(4rem,9vw,6.5rem)] font-light leading-[0.8]">{space.stat.value}</span>
            <span class="max-w-[12rem] pb-1 text-[0.68rem] uppercase leading-relaxed tracking-[0.2em] text-white/60">{space.stat.label}</span>
          </div>
        )}
        <div class="prose-editorial mt-8 [&_p]:!text-white/75">{space.body.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="space-y-3 md:col-span-7 md:col-start-6 lg:col-span-7 lg:col-start-6">
        <Photo id={main} sizes="(min-width: 768px) 55vw, 100vw" />
        {more.length > 0 && (
          <div class="aspect-row" style="--row-gap: 0.75rem">
            {more.map((id) => <div style={`--aspect:${aspect(id)}`}><Photo id={id} sizes="(min-width: 768px) 28vw, 50vw" /></div>)}
          </div>
        )}
      </div>
    </div>
  )}

  {space.layout === 'panorama' && (
    <div>
      <div class="container-x mx-auto mb-14 max-w-3xl text-center md:mb-20" data-reveal>
        <p class="eyebrow">{num} — {space.eyebrow}</p>
        <h3 id={headingId} class="heading mt-6">{space.title}</h3>
        <div class="prose-editorial mx-auto mt-7 max-w-xl">{space.body.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="md:px-10 xl:px-16"><Photo id={main} sizes="100vw" maxVh={86} /></div>
      {more.length > 0 && (
        <div class="container-x mt-3">
          <div class="aspect-row" style="--row-gap: 0.75rem">
            {more.map((id) => <div style={`--aspect:${aspect(id)}`}><Photo id={id} sizes="50vw" /></div>)}
          </div>
        </div>
      )}
    </div>
  )}
</article>
