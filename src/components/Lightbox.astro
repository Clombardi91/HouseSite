---
/**
 * Full-screen photo viewer: swipe on touch screens, arrow keys on desktop,
 * Escape or the close button to exit. Images are served at screen resolution.
 */
import { getImage } from 'astro:assets';
import { categoryLabel, galleryPhotos } from '../lib/content';

const photos = await Promise.all(
  galleryPhotos().map(async (p) => {
    const image = p.image;
    if (!image) return { alt: p.alt, caption: p.caption ?? '', room: categoryLabel(p.category), file: p.file, aspect: p.aspect };
    const widths = [960, 1600, 2400].filter((w) => w <= image.width);
    if (!widths.length) widths.push(image.width);
    const variants = await Promise.all(widths.map((w) => getImage({ src: image, width: w, format: 'webp', quality: 82 })));
    return {
      src: variants[variants.length - 1].src,
      srcset: variants.map((v, i) => `${v.src} ${widths[i]}w`).join(', '),
      alt: p.alt,
      caption: p.caption ?? '',
      room: categoryLabel(p.category),
      aspect: p.aspect,
    };
  }),
);
---

<dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
  <div class="lb-shell">
    <div class="lb-top">
      <p class="lb-meta" aria-live="polite"><span class="lb-count"></span><span class="lb-room"></span></p>
      <button type="button" class="lb-close" data-lb="close" aria-label="Close photo viewer">
        <span>Close</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" /></svg>
      </button>
    </div>
    <div class="lb-stage">
      <button type="button" class="lb-nav lb-prev" data-lb="prev" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
      </button>
      <figure class="lb-figure">
        <img class="lb-img" alt="" decoding="async" />
        <div class="lb-placeholder" hidden></div>
      </figure>
      <button type="button" class="lb-nav lb-next" data-lb="next" aria-label="Next photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
      </button>
    </div>
    <p class="lb-caption"></p>
  </div>
  <script type="application/json" id="lightbox-data" set:html={JSON.stringify(photos)} />
</dialog>

<style>
  .lightbox { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #151412; color: #f4f1ea; opacity: 0; transition: opacity 0.45s var(--ease-editorial); overscroll-behavior: contain; }
  .lightbox[open].is-open { opacity: 1; }
  .lightbox::backdrop { background: transparent; }
  .lb-shell { display: grid; grid-template-rows: auto 1fr auto; height: 100%; padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
  .lb-top { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1.25rem; }
  .lb-meta { display: flex; gap: 1.25rem; font-size: 0.65rem; letter-spacing: 0.24em; text-transform: uppercase; color: rgb(244 241 234 / 0.7); }
  .lb-count { font-variant-numeric: tabular-nums; color: #f4f1ea; }
  .lb-close { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0 0.25rem 0 0.75rem; font-size: 0.65rem; letter-spacing: 0.24em; text-transform: uppercase; color: #f4f1ea; opacity: 0.85; transition: opacity 0.3s; }
  .lb-close:hover { opacity: 1; }
  .lb-stage { position: relative; display: flex; align-items: center; justify-content: center; min-height: 0; touch-action: pinch-zoom; user-select: none; }
  .lb-figure { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; margin: 0; padding: 0 0.5rem; }
  @media (min-width: 768px) { .lb-figure { padding: 0 6.5rem; } }
  .lb-img, .lb-placeholder { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; transition: opacity 0.45s var(--ease-editorial), transform 0.55s var(--ease-editorial); }
  .lb-placeholder { width: min(100%, 70vh * var(--aspect, 1.5)); aspect-ratio: var(--aspect, 1.5); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem; text-align: center; background: #2a2825; outline: 1px dashed rgb(255 255 255 / 0.2); outline-offset: -10px; font-size: 0.75rem; color: rgb(244 241 234 / 0.65); }
  .lb-placeholder[hidden] { display: none; }
  .is-leaving { opacity: 0; transform: translateX(calc(var(--dir, 1) * -28px)); }
  .is-entering { opacity: 0; transform: translateX(calc(var(--dir, 1) * 28px)); transition: none; }
  .lb-nav { position: absolute; top: 50%; z-index: 2; display: none; width: 3.25rem; height: 3.25rem; padding: 0.85rem; transform: translateY(-50%); color: #f4f1ea; opacity: 0.6; transition: opacity 0.3s; }
  .lb-nav:hover { opacity: 1; }
  .lb-prev { left: 1.5rem; } .lb-next { right: 1.5rem; }
  @media (min-width: 768px) { .lb-nav { display: block; } }
  .lb-caption { min-height: 3.5rem; padding: 1rem 1.25rem 1.25rem; text-align: center; font-family: var(--font-serif); font-size: 1.2rem; font-style: italic; color: rgb(244 241 234 / 0.85); }
</style>

<script>
  type Item = { src?: string; srcset?: string; alt: string; caption: string; room: string; file?: string; aspect: number };
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const items: Item[] = JSON.parse(document.getElementById('lightbox-data')!.textContent || '[]');
  const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
  const ph = dialog.querySelector<HTMLDivElement>('.lb-placeholder')!;
  const count = dialog.querySelector('.lb-count')!;
  const room = dialog.querySelector('.lb-room')!;
  const caption = dialog.querySelector('.lb-caption')!;
  const stage = dialog.querySelector<HTMLElement>('.lb-stage')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let index = 0;
  let opener: HTMLElement | null = null;

  const pad = (n: number) => String(n).padStart(2, '0');

  function preload(i: number) {
    const it = items[(i + items.length) % items.length];
    if (it?.src) { const p = new Image(); p.sizes = '100vw'; if (it.srcset) p.srcset = it.srcset; p.src = it.src; }
  }

  function render(dir = 0) {
    const it = items[index];
    count.textContent = `${pad(index + 1)} / ${pad(items.length)}`;
    room.textContent = it.room;
    caption.textContent = it.caption;
    const target = it.src ? img : ph;
    const show = () => {
      img.hidden = !it.src;
      ph.hidden = !!it.src;
      if (it.src) {
        img.sizes = '100vw';
        img.srcset = it.srcset ?? '';
        img.src = it.src;
        img.alt = it.alt;
      } else {
        ph.style.setProperty('--aspect', String(it.aspect));
        const line = (tag: string, text: string, style: string) => Object.assign(document.createElement(tag), { textContent: text, style });
        ph.replaceChildren(
          line('span', 'Photograph to come', 'letter-spacing:.22em;text-transform:uppercase;font-size:.6rem'),
          line('span', it.caption || it.alt, 'font-family:var(--font-serif);font-size:1.4rem;color:#f4f1ea'),
          line('code', `src/assets/photos/${it.file}`, 'font-size:.65rem'),
        );
      }
      if (dir && !reduce.matches) {
        target.style.setProperty('--dir', String(dir));
        target.classList.add('is-entering');
        requestAnimationFrame(() => requestAnimationFrame(() => target.classList.remove('is-entering')));
      }
    };
    const current = img.hidden ? ph : img;
    if (dir && !reduce.matches && dialog.open) {
      current.style.setProperty('--dir', String(dir));
      current.classList.add('is-leaving');
      setTimeout(() => { current.classList.remove('is-leaving'); show(); }, 220);
    } else show();
    preload(index + 1);
    preload(index - 1);
  }

  function go(step: number) {
    if (items.length < 2) return;
    index = (index + step + items.length) % items.length;
    render(step);
  }

  function open(i: number, trigger: HTMLElement) {
    index = i;
    opener = trigger;
    render();
    dialog.showModal();
    document.documentElement.style.overflow = 'hidden';
    requestAnimationFrame(() => dialog.classList.add('is-open'));
  }

  function close() {
    dialog.classList.remove('is-open');
    setTimeout(() => {
      dialog.close();
    }, reduce.matches ? 0 : 350);
  }

  dialog.addEventListener('close', () => {
    dialog.classList.remove('is-open');
    document.documentElement.style.overflow = '';
    opener?.focus({ preventScroll: true });
  });
  dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });

  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element).closest<HTMLElement>('[data-lightbox-open]');
    if (trigger) { open(Number(trigger.dataset.lightboxOpen), trigger); return; }
    const ctl = (e.target as Element).closest<HTMLElement>('[data-lb]');
    if (ctl && dialog.contains(ctl)) {
      const action = ctl.dataset.lb;
      if (action === 'close') close();
      else go(action === 'next' ? 1 : -1);
    }
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    else if (e.key === 'Home') { e.preventDefault(); index = 0; render(-1); }
    else if (e.key === 'End') { e.preventDefault(); index = items.length - 1; render(1); }
  });

  // Swipe left / right to move between photos, swipe down to close.
  let startX = 0, startY = 0, dx = 0, dy = 0, tracking = false;
  stage.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'mouse' || (e.target as Element).closest('button')) return;
    tracking = true; startX = e.clientX; startY = e.clientY; dx = dy = 0;
  });
  stage.addEventListener('pointermove', (e) => {
    if (!tracking) return;
    dx = e.clientX - startX; dy = e.clientY - startY;
    const el = img.hidden ? ph : img;
    if (Math.abs(dx) > Math.abs(dy)) { el.style.transition = 'none'; el.style.transform = `translateX(${dx}px)`; }
    else if (dy > 0) { el.style.transition = 'none'; el.style.transform = `translateY(${dy}px)`; el.style.opacity = String(Math.max(0.3, 1 - dy / 400)); }
  });
  const end = () => {
    if (!tracking) return;
    tracking = false;
    const el = img.hidden ? ph : img;
    el.style.transition = ''; el.style.transform = ''; el.style.opacity = '';
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
    else if (dy > 110 && dy > Math.abs(dx)) close();
  };
  stage.addEventListener('pointerup', end);
  stage.addEventListener('pointercancel', end);
</script>
