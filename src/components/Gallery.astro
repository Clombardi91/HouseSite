---
import Photo from './Photo.astro';
import Lightbox from './Lightbox.astro';
import { property } from '../config/property';
import { buildRows, galleryPhotos } from '../lib/content';

const photos = galleryPhotos();
const chapters = property.galleryCategories
  .map((c) => ({ ...c, photos: photos.filter((p) => p.category === c.id) }))
  .filter((c) => c.photos.length > 0);
---

<section id="gallery" class="bg-ivory py-24 md:py-36" aria-labelledby="gallery-heading">
  <div class="container-x">
    <div class="grid gap-8 md:grid-cols-12 md:gap-x-10" data-reveal>
      <div class="md:col-span-7">
        <p class="eyebrow flex items-center gap-4"><span class="brass-rule"></span>The Gallery</p>
        <h2 id="gallery-heading" class="display mt-7 text-[clamp(2.5rem,6.4vw,5.4rem)]">Every room, in its own light.</h2>
      </div>
      <p class="self-end text-ink md:col-span-4 md:col-start-9">
        {photos.length} photographs of the home, inside and out. Select any image to view it full screen.
      </p>
    </div>

    <nav aria-label="Gallery rooms" class="gallery-index sticky top-0 z-30 -mx-5 mt-14 overflow-x-auto bg-ivory/95 px-5 backdrop-blur md:static md:mx-0 md:mt-20 md:overflow-visible md:bg-transparent md:px-0 md:backdrop-blur-none">
      <ul class="flex gap-7 whitespace-nowrap border-y border-line py-4 text-[0.68rem] font-medium uppercase tracking-[0.2em] md:flex-wrap md:gap-x-9 md:gap-y-3 md:whitespace-normal">
        {chapters.map((c) => (
          <li>
            <a href={`#gallery-${c.id}`} class="group inline-flex items-baseline gap-2 text-ink hover:text-charcoal">
              <span class="link-line [background-size:0%_1px] group-hover:[background-size:100%_1px]">{c.label}</span>
              <span class="text-[0.6rem] text-muted">{String(c.photos.length).padStart(2, '0')}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-16 space-y-24 md:mt-24 md:space-y-36">
      {chapters.map((c, ci) => (
        <section id={`gallery-${c.id}`} class="grid gap-8 md:grid-cols-12 md:gap-x-10" aria-labelledby={`gallery-${c.id}-title`}>
          <header class="md:col-span-3">
            <div class="md:sticky md:top-28" data-reveal>
              <p class="text-[0.65rem] tracking-[0.24em] text-muted">{String(ci + 1).padStart(2, '0')} / {String(chapters.length).padStart(2, '0')}</p>
              <h3 id={`gallery-${c.id}-title`} class="mt-3 font-serif text-[2rem] leading-tight md:text-[2.4rem]">{c.label}</h3>
              <span class="brass-rule mt-5 block"></span>
            </div>
          </header>
          <div class="space-y-3 md:col-span-9 md:space-y-4">
            {buildRows(c.photos).map((row) =>
              row.kind === 'full' ? (
                <Photo id={row.photos[0].id} sizes="(min-width: 1472px) 1000px, (min-width: 768px) 72vw, 100vw" maxVh={80} />
              ) : row.kind === 'pair' ? (
                <div class="aspect-row" style="--row-gap: 0.75rem">
                  {row.photos.map((p) => (
                    <div style={`--aspect:${p.aspect}`}><Photo id={p.id} sizes="(min-width: 768px) 36vw, 50vw" /></div>
                  ))}
                </div>
              ) : (
                <div class:list={['flex', row.align === 'end' ? 'justify-end' : 'justify-start']}>
                  <Photo id={row.photos[0].id} class={row.photos[0].aspect < 1 ? 'w-3/5 md:w-1/2' : 'w-5/6 md:w-2/3'} sizes="(min-width: 768px) 48vw, 83vw" />
                </div>
              ),
            )}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<Lightbox />
